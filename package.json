    "@jest/globals": "^30.2.0",
    "@manufac/eslint-config": "^5.6.0",
    "@manufac/prettier-config": "^1.8.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/addon-styling-webpack": "^3.0.0",
