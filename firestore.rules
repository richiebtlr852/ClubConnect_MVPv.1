rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // club collection rules (lowercase to match code)
    match /club/{clubId} {
      // Anyone authenticated can read clubs
      allow read: if isAuthenticated();
      // Only authenticated users can create clubs
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Only the creator can update/delete their club
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // packages collection rules (lowercase to match code)
    match /packages/{packageId} {
      // Anyone authenticated can read packages
      allow read: if isAuthenticated();
      // Only authenticated users can create packages
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Only the creator can update/delete their packages
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // mail collection rules (for email invites)
    match /mail/{mailId} {
      // Anyone authenticated can read mail
      allow read: if isAuthenticated();
      // Only authenticated users can create mail
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Only the creator can update/delete their mail
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // users collection rules (for future user profiles)
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Users can create/update their own profile
      allow create, update: if isOwner(userId);
      // Users can delete their own profile
      allow delete: if isOwner(userId);
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}